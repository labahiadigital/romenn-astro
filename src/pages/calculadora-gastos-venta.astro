---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CalculadoraGastos from "@/components/CalculadoraGastos";
---

<BaseLayout
  title="Calculadora de Gastos de Venta"
  description="Calcula una estimación de los gastos e impuestos de la venta de tu vivienda en la Comunidad de Madrid. Descubre cuánto recibirías antes de cancelar una posible hipoteca."
  hasForm={true}
>
  <section class="pt-32 pb-24 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-4xl mx-auto px-6">

      <!-- Header -->
      <div class="text-center mb-12">
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.25em] text-accent font-bold mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
          Herramienta Gratuita
        </span>
        <h1 class="text-4xl md:text-5xl font-serif mb-6">
          Calculadora de Gastos de Venta
        </h1>
        <p class="text-xl text-muted-foreground font-light max-w-2xl mx-auto">
          Estima los principales gastos e impuestos de la venta de tu vivienda
          en la Comunidad de Madrid en menos de 2 minutos.
        </p>
      </div>

      <!-- Benefits -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
        <div class="flex items-center justify-center gap-2 text-sm text-muted-foreground bg-white rounded-lg py-3 px-4 border border-slate-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Resultado en 2 minutos
        </div>
        <div class="flex items-center justify-center gap-2 text-sm text-muted-foreground bg-white rounded-lg py-3 px-4 border border-slate-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
          Sin compromiso
        </div>
        <div class="flex items-center justify-center gap-2 text-sm text-muted-foreground bg-white rounded-lg py-3 px-4 border border-slate-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          Comunidad de Madrid
        </div>
      </div>

      <CalculadoraGastos client:visible />

      <!-- WhatsApp alternative -->
      <div class="mt-12 text-center">
        <div class="inline-flex items-center gap-3 bg-[#25D366]/10 border border-[#25D366]/20 rounded-xl px-6 py-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <div class="text-left">
            <p class="text-sm font-medium text-foreground">¿Prefieres hablar con un asesor?</p>
            <a href="https://wa.me/34747488562?text=Hola%2C%20quiero%20saber%20cuánto%20me%20costaría%20vender%20mi%20vivienda" class="text-sm text-[#25D366] font-bold hover:underline" target="_blank" rel="noopener">
              Escríbenos por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
