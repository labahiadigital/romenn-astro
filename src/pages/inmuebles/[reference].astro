---
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";
import PropertyGallery from "@/components/PropertyGallery";
import { fetchProperty, formatPrice, getLocationLabel, getOrientationLabel, type PublicProperty } from "@/lib/api";

const { reference } = Astro.params;

let property: PublicProperty | null = null;
let notFound = false;

try {
  property = await fetchProperty(reference!);
} catch {
  notFound = true;
}

if (notFound || !property) {
  return Astro.redirect("/inmuebles");
}

const p = property;
const loc = getLocationLabel(p.location);
const price = p.price ? formatPrice(p.price) : null;
const rental = p.rental_price ? `${formatPrice(p.rental_price)}/mes` : null;
const orientation = getOrientationLabel(p);

const conservationLabels: Record<string, string> = { good: "Buen estado", new: "Nuevo", needs_renovation: "Necesita reforma" };
const heatingLabels: Record<string, string> = {
  individual_gas: "Gas individual", central_gas: "Gas central",
  individual_air_conditioning_heat_pump: "Bomba de calor individual",
  central_air_conditioning_heat_pump: "Bomba de calor central",
  individual_electric: "Eléctrica individual", central_electric: "Eléctrica central",
};
const featureLabels: Record<string, string> = {
  ascensor: "Ascensor", aire_con: "Aire acondicionado", calefaccion: "Calefacción",
  piscina_com: "Piscina comunitaria", piscina_prop: "Piscina privada", jardin: "Jardín",
  terraza: "Terraza", balcon: "Balcón", trastero: "Trastero", sotano: "Sótano",
  patio: "Patio", muebles: "Amueblado", arma_empo: "Armarios empotrados",
  chimenea: "Chimenea", gimnasio: "Gimnasio", sauna: "Sauna", jacuzzi: "Jacuzzi",
  alarma: "Alarma", puerta_blin: "Puerta blindada", video_port: "Videoportero",
  vigilancia_24: "Vigilancia 24h", adaptadominus: "Adaptado",
};
const activeFeatures = Object.entries(p.features).filter(([, v]) => v).map(([k]) => featureLabels[k] || k);

const badges: string[] = [];
if (p.is_penthouse) badges.push("Ático");
if (p.is_duplex) badges.push("Dúplex");
if (p.is_studio) badges.push("Estudio");
if (p.is_top_floor) badges.push("Última planta");

const stats = [
  p.m_cons && { label: "Superficie", value: `${p.m_cons} m²` },
  p.habitaciones && { label: "Habitaciones", value: String(p.habitaciones) },
  p.banyos && { label: "Baños", value: String(p.banyos) },
  p.planta != null && { label: "Planta", value: p.planta === 0 ? "Bajo" : `${p.planta}ª` },
  p.parking && p.parking > 0 && { label: "Parking", value: String(p.parking) },
  p.m_terraza && { label: "Terraza", value: `${p.m_terraza} m²` },
].filter(Boolean) as Array<{ label: string; value: string }>;
---

<BaseLayout title={`${p.title || "Propiedad"} | Römenn`}>
  <article class="pt-28">
    {/* Gallery - interactive React component */}
    <section class="bg-slate-100">
      <PropertyGallery
        client:load
        photos={p.photos}
        title={p.title || "Propiedad"}
      />
    </section>

    {/* Content */}
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center gap-3 text-sm text-muted-foreground mb-6">
          <a href="/inmuebles/" class="hover:text-primary transition-colors">Inmuebles</a>
          <span>/</span>
          <span>{p.reference}</span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          {/* Main content */}
          <div class="lg:col-span-2 space-y-10">
            {/* Header */}
            <div>
              <h1 class="text-3xl md:text-4xl font-serif text-primary mb-3">
                {p.is_sold && <span class="inline-block bg-red-700 text-white text-sm font-bold uppercase tracking-wider px-3 py-1 rounded-full mr-3 align-middle">Vendido</span>}
                {p.title || p.property_type || "Propiedad"}
              </h1>
              {loc && (
                <p class="text-muted-foreground flex items-center gap-2 text-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-accent"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                  {loc}
                </p>
              )}
            </div>

            {/* Stats bar */}
            {stats.length > 0 && (
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
                {stats.map((s) => (
                  <div class="bg-slate-50 rounded-xl p-4 text-center">
                    <p class="text-2xl font-serif text-primary">{s.value}</p>
                    <p class="text-xs text-muted-foreground uppercase tracking-wider mt-1">{s.label}</p>
                  </div>
                ))}
              </div>
            )}

            {/* Description */}
            {p.description && (
              <div>
                <h2 class="text-xl font-serif text-primary mb-4">Descripción</h2>
                <div class="text-muted-foreground font-light leading-relaxed whitespace-pre-line">
                  {p.description}
                </div>
              </div>
            )}

            {/* Features */}
            {activeFeatures.length > 0 && (
              <div>
                <h2 class="text-xl font-serif text-primary mb-4">Equipamiento</h2>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                  {activeFeatures.map((f) => (
                    <div class="flex items-center gap-2 bg-emerald-50 text-emerald-700 px-4 py-3 rounded-xl text-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                      {f}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Technical details */}
            <div>
              <h2 class="text-xl font-serif text-primary mb-4">Detalles técnicos</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {p.conservation_status && (
                  <div class="flex justify-between bg-slate-50 px-4 py-3 rounded-xl">
                    <span class="text-sm text-muted-foreground">Conservación</span>
                    <span class="text-sm font-medium">{conservationLabels[p.conservation_status] || p.conservation_status}</span>
                  </div>
                )}
                {p.energy_certificate_rating && (
                  <div class="flex justify-between bg-slate-50 px-4 py-3 rounded-xl">
                    <span class="text-sm text-muted-foreground">Certificado energético</span>
                    <span class="text-sm font-medium">{p.energy_certificate_rating === "in_process" ? "En trámite" : p.energy_certificate_rating === "exempt" ? "Exento" : p.energy_certificate_rating.toUpperCase()}</span>
                  </div>
                )}
                {p.heating_type && (
                  <div class="flex justify-between bg-slate-50 px-4 py-3 rounded-xl">
                    <span class="text-sm text-muted-foreground">Calefacción</span>
                    <span class="text-sm font-medium">{heatingLabels[p.heating_type] || p.heating_type}</span>
                  </div>
                )}
                {orientation && (
                  <div class="flex justify-between bg-slate-50 px-4 py-3 rounded-xl">
                    <span class="text-sm text-muted-foreground">Orientación</span>
                    <span class="text-sm font-medium">{orientation}</span>
                  </div>
                )}
                {p.antiguedad && (
                  <div class="flex justify-between bg-slate-50 px-4 py-3 rounded-xl">
                    <span class="text-sm text-muted-foreground">Año construcción</span>
                    <span class="text-sm font-medium">{p.antiguedad}</span>
                  </div>
                )}
                {p.m_utiles && (
                  <div class="flex justify-between bg-slate-50 px-4 py-3 rounded-xl">
                    <span class="text-sm text-muted-foreground">Superficie útil</span>
                    <span class="text-sm font-medium">{p.m_utiles} m²</span>
                  </div>
                )}
                {p.m_parcela && (
                  <div class="flex justify-between bg-slate-50 px-4 py-3 rounded-xl">
                    <span class="text-sm text-muted-foreground">Parcela</span>
                    <span class="text-sm font-medium">{p.m_parcela} m²</span>
                  </div>
                )}
                {p.community_fees && (
                  <div class="flex justify-between bg-slate-50 px-4 py-3 rounded-xl">
                    <span class="text-sm text-muted-foreground">Comunidad</span>
                    <span class="text-sm font-medium">{formatPrice(p.community_fees)}/mes</span>
                  </div>
                )}
              </div>
            </div>

            {/* Virtual tour */}
            {p.virtual_tour_url && (
              <div>
                <h2 class="text-xl font-serif text-primary mb-4">Visita virtual</h2>
                <div class="rounded-2xl border border-slate-200 overflow-hidden">
                  <div class="aspect-video">
                    <iframe
                      src={p.virtual_tour_url}
                      class="w-full h-full"
                      allow="fullscreen"
                      allowfullscreen
                      title="Visita virtual"
                      loading="lazy"
                    ></iframe>
                  </div>
                </div>
              </div>
            )}

            {/* Photo gallery handled by interactive lightbox above */}
          </div>

          {/* Sidebar */}
          <div class="lg:col-span-1">
            <div class="sticky top-28 space-y-6">
              {/* Price card */}
              <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
                {p.is_sold && (
                  <div class="mb-4 bg-red-50 border border-red-200 rounded-xl px-4 py-3 text-center">
                    <p class="text-red-700 font-bold uppercase tracking-wider text-sm">Vendido</p>
                  </div>
                )}
                {price && (
                  <div class="mb-2">
                    <p class:list={["text-3xl font-serif", p.is_sold ? "text-muted-foreground line-through" : "text-primary"]}>{price}</p>
                    {p.m_cons && <p class="text-sm text-muted-foreground">{formatPrice((p.price || 0) / p.m_cons)}/m²</p>}
                  </div>
                )}
                {rental && !price && (
                  <p class:list={["text-3xl font-serif mb-2", p.is_sold ? "text-muted-foreground line-through" : "text-primary"]}>{rental}</p>
                )}
                {rental && price && (
                  <p class="text-lg text-muted-foreground mb-4">Alquiler: {rental}</p>
                )}

                <div class="border-t border-slate-100 pt-6 mt-6">
                  {p.is_sold ? (
                    <div>
                      <p class="text-sm text-muted-foreground mb-4">Este inmueble ya ha sido vendido. ¿Buscas algo similar?</p>
                      <a href="/contacto/" class="w-full inline-flex items-center justify-center bg-primary text-white px-6 py-4 rounded-xl text-sm font-bold uppercase tracking-widest hover:bg-primary/90 transition-colors">
                        Consultar inmuebles similares
                      </a>
                    </div>
                  ) : (
                    <div>
                      <p class="text-sm text-muted-foreground mb-4">¿Te interesa este inmueble?</p>
                      <a href={`/contacto?ref=${p.reference}`} class="w-full inline-flex items-center justify-center bg-primary text-white px-6 py-4 rounded-xl text-sm font-bold uppercase tracking-widest hover:bg-primary/90 transition-colors">
                        Solicitar información
                      </a>
                      <a href="tel:+34659398860" class="mt-3 w-full inline-flex items-center justify-center gap-2 border-2 border-primary text-primary px-6 py-3.5 rounded-xl text-sm font-bold uppercase tracking-widest hover:bg-primary/5 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        Llamar ahora
                      </a>
                    </div>
                  )}
                </div>
              </div>

              {/* Reference card */}
              <div class="bg-slate-50 rounded-2xl p-6 text-center">
                <p class="text-xs text-muted-foreground uppercase tracking-widest mb-1">Referencia</p>
                <p class="text-lg font-serif text-primary">{p.reference}</p>
              </div>

              {/* Römenn guarantee */}
              <div class="bg-primary/5 rounded-2xl p-6 border border-primary/10">
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                  </div>
                  <h3 class="font-serif text-primary">Garantía Römenn</h3>
                </div>
                <p class="text-sm text-muted-foreground font-light leading-relaxed">
                  Este inmueble ha sido verificado por nuestro equipo. Documentación auditada y due diligence completa disponible.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="py-16 bg-primary text-white text-center">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-serif mb-4">¿Quieres visitar este inmueble?</h2>
        <p class="text-white/70 font-light mb-8">Organizamos una visita personalizada sin compromiso.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={`/contacto?ref=${p.reference}`} class="inline-flex items-center justify-center bg-white text-primary px-8 py-4 text-sm tracking-widest uppercase font-bold rounded-xl">
            Solicitar visita
          </a>
          <a href="/inmuebles/" class="inline-flex items-center justify-center border-2 border-white text-white px-8 py-4 text-sm tracking-widest uppercase font-bold rounded-xl">
            Ver más inmuebles
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
