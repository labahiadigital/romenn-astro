---
import LandingLayout from "@/layouts/LandingLayout.astro";
import VenderLeadForm from "@/components/VenderLeadForm.tsx";

const PHONE_TEL = "+34747488562";
const WHATSAPP_URL = "https://wa.me/34747488562?text=Hola,%20quiero%20vender%20mi%20casa%20en%20Rivas";

const situaciones = [
  {
    titulo: "Has heredado una vivienda",
    desc: "Te guiamos con el papeleo y los plazos para que vender no se sume a la carga.",
  },
  {
    titulo: "Separación o divorcio",
    desc: "Gestionamos la venta con discreción y agilidad, para que paséis página antes.",
  },
  {
    titulo: "Vendes para comprar",
    desc: "Coordinamos venta y compra para que no te quedes sin casa por el camino.",
  },
  {
    titulo: "Preparas tu jubilación",
    desc: "Convertimos el patrimonio de tu vivienda en la tranquilidad que mereces.",
  },
  {
    titulo: "Inversión y rentabilidad",
    desc: "Te decimos cuándo y a qué precio vender para sacarle el máximo a tu inmueble.",
  },
];

const valor = [
  {
    titulo: "Sabrás cuánto vale de verdad",
    desc: "Una valoración con datos reales del mercado de Rivas, no una cifra inflada para captarte. Sin humo y sin compromiso.",
  },
  {
    titulo: "Nos adaptamos a tu ritmo",
    desc: "Herencia, divorcio, jubilación o un nuevo proyecto: agilidad cuando hace falta, calma y respeto cuando toca.",
  },
  {
    titulo: "Expertos de Madrid, trato boutique",
    desc: "Años en el mercado de Madrid y más de 250 familias acompañadas. Hablas siempre con tu asesor, no con un centralita.",
  },
];

const pasos = [
  {
    n: "1",
    titulo: "Cuéntanos tu caso",
    desc: "Por formulario, WhatsApp o teléfono. En 2 minutos.",
  },
  {
    n: "2",
    titulo: "Valoramos tu vivienda gratis",
    desc: "Con datos reales de tu calle y tu zona. Te lo explicamos sin tecnicismos.",
  },
  {
    n: "3",
    titulo: "Vendemos al mejor precio",
    desc: "Nos encargamos de todo y te acompañamos hasta la firma, a tu ritmo.",
  },
];

const testimonios = [
  {
    texto: "Rubén me ayudó a vender mi piso y estoy encantado con su trabajo, su honestidad y su saber hacer. 100 % recomendable.",
    autor: "José María M.",
    detalle: "Vendió su piso en Rivas",
  },
  {
    texto: "Desde el primer momento resolvieron todas mis dudas y me plantearon las opciones más realistas. Cero presión.",
    autor: "David Ruiz",
    detalle: "Vendió para comprar",
  },
];
---

<LandingLayout
  title="Vende tu casa en Madrid — Valoración gratis en 24 h"
  description="Vende tu casa en Madrid con quien conoce tu zona como nadie. Valoración gratuita y sin compromiso en menos de 24 h. Más de 250 familias ya han confiado en Römenn."
>
  <!-- Sección 1 · Hero -->
  <section class="bg-secondary/40">
    <div class="mx-auto grid max-w-5xl items-center gap-12 px-4 py-14 sm:px-6 md:grid-cols-[1.05fr_0.95fr] md:py-24">
      <div>
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/15 bg-white px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
          Inmobiliaria boutique · Rivas-Vaciamadrid
        </p>
        <h1 class="font-serif text-[2.5rem] leading-[1.08] text-foreground sm:text-5xl">
          Vende tu casa en Madrid con quien conoce tu zona como nadie
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
          Te decimos cuánto vale de verdad tu vivienda con datos reales del
          mercado. Valoración gratuita y sin compromiso en menos de 24 horas.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="#formulario" class="btn-cta-primary group">
            Pedir mi valoración gratis
            <svg class="transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn-cta-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
            Hablar por WhatsApp
          </a>
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
          <span class="inline-flex items-center gap-1.5">
            <span class="flex text-primary">
              {[0, 1, 2, 3, 4].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
              ))}
            </span>
            <strong class="font-semibold text-foreground">+250 familias</strong> acompañadas
          </span>
          <span class="hidden h-4 w-px bg-border sm:inline-block"></span>
          <span>Respuesta en menos de 2 h laborables</span>
        </div>
      </div>

      <div class="md:pl-2">
        <div class="rounded-2xl border border-border bg-white p-7 shadow-xl">
          <p class="font-serif text-2xl text-foreground">Lo que consigues</p>
          <ul class="mt-5 space-y-4">
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span class="text-muted-foreground">El precio real de tu casa, con datos del mercado de Madrid.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span class="text-muted-foreground">Un asesor que te llama en menos de 2 horas laborables.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span class="text-muted-foreground">Trato cercano y honesto, sin presión y sin compromiso.</span>
            </li>
          </ul>
          <div class="mt-6 border-t border-border pt-5 text-center">
            <p class="font-serif text-3xl text-primary">24 h</p>
            <p class="text-sm text-muted-foreground">es lo que tardas en saber cuánto vale tu casa</p>
          </div>
          <a href="#formulario" class="btn-cta-primary mt-6 w-full">
            Empezar ahora — es gratis
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 2 · Marca humana -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 md:py-24">
      <blockquote class="font-serif text-[1.7rem] italic leading-snug text-primary sm:text-3xl">
        “El verdadero lujo es sentirse en casa.”
      </blockquote>
      <p class="mt-7 text-lg leading-relaxed text-muted-foreground">
        En Römenn no vendemos casas: acompañamos a personas. Detrás de cada
        venta hay una historia —y a veces un momento delicado—, así que adaptamos
        el ritmo al tuyo: agilidad cuando hace falta, calma y respeto cuando
        toca. Nuestro compromiso es siempre el mismo: cuidar el patrimonio de
        toda una vida y dejarte tranquilo en cada paso.
      </p>
    </div>
  </section>

  <!-- Sección 3 · ¿En qué momento estás? -->
  <section class="bg-secondary/40">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
      <div class="max-w-2xl">
        <h2 class="font-serif text-3xl text-foreground sm:text-4xl">¿En qué momento estás?</h2>
        <p class="mt-4 text-lg text-muted-foreground">
          No todas las ventas nacen de la misma circunstancia. Dinos cuál es la
          tuya y adaptamos el plan —y el ritmo— a lo que necesitas.
        </p>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {situaciones.map((s) => (
          <div class="group rounded-xl border border-border bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-lg">
            <h3 class="font-serif text-xl text-foreground">{s.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{s.desc}</p>
          </div>
        ))}
        <div class="flex flex-col justify-center rounded-xl border border-dashed border-primary/40 bg-white p-6">
          <p class="text-sm leading-relaxed text-muted-foreground">
            ¿Tu caso no aparece aquí? No importa: cuéntanoslo y te acompañamos
            igual.
          </p>
          <a href="#formulario" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
            Cuéntanos tu situación
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 4 · Propuesta de valor -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
      <div class="mb-12 max-w-2xl">
        <h2 class="font-serif text-3xl text-foreground sm:text-4xl">Por qué vender con Römenn</h2>
        <p class="mt-4 text-lg text-muted-foreground">
          Lo que de verdad importa cuando pones en venta el patrimonio de una vida.
        </p>
      </div>
      <div class="grid gap-10 md:grid-cols-3">
        {valor.map((v) => (
          <div>
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
            <h3 class="font-serif text-xl text-foreground">{v.titulo}</h3>
            <p class="mt-2 leading-relaxed text-muted-foreground">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sección 5 · Formulario (objetivo principal) -->
  <section id="formulario" class="scroll-mt-20 bg-secondary/40">
    <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 md:py-24">
      <div class="mb-8 text-center">
        <h2 class="font-serif text-3xl text-foreground sm:text-4xl">Pide tu valoración gratuita</h2>
        <p class="mt-3 text-lg text-muted-foreground">
          Cuéntanos lo justo. Te llamamos y te decimos cuánto vale tu vivienda,
          sin compromiso.
        </p>
      </div>
      <VenderLeadForm client:load />
    </div>
  </section>

  <!-- Sección 6 · Prueba social -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
      <h2 class="mb-10 text-center font-serif text-3xl text-foreground sm:text-4xl">
        Familias que ya han confiado en nosotros
      </h2>
      <div class="grid gap-6 md:grid-cols-2">
        {testimonios.map((t) => (
          <figure class="flex flex-col rounded-2xl border border-border bg-secondary/30 p-7">
            <div class="mb-4 flex gap-1 text-primary">
              {[0, 1, 2, 3, 4].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <blockquote class="text-lg leading-relaxed text-foreground">“{t.texto}”</blockquote>
            <figcaption class="mt-5 text-sm text-muted-foreground">
              <span class="font-semibold text-foreground">{t.autor}</span> · {t.detalle}
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 text-center text-sm text-muted-foreground sm:flex-row sm:gap-8">
        <span class="font-semibold text-primary">+250 familias acompañadas</span>
        <span class="hidden sm:inline">·</span>
        <span>Expertos en Rivas-Vaciamadrid</span>
        <span class="hidden sm:inline">·</span>
        <span>Valoración gratuita y sin compromiso</span>
      </div>
    </div>
  </section>

  <!-- Sección 7 · Cómo funciona -->
  <section class="bg-secondary/40">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
      <h2 class="text-center font-serif text-3xl text-foreground sm:text-4xl">Vender es más fácil de lo que crees</h2>
      <p class="mx-auto mt-4 max-w-xl text-center text-lg text-muted-foreground">
        Tres pasos. Tú decides el ritmo, nosotros nos encargamos del resto.
      </p>
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {pasos.map((p) => (
          <div class="relative text-center">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-primary text-xl font-bold text-primary-foreground shadow-md">
              {p.n}
            </div>
            <h3 class="font-serif text-xl text-foreground">{p.titulo}</h3>
            <p class="mt-2 leading-relaxed text-muted-foreground">{p.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="#formulario" class="btn-cta-primary group inline-flex">
          Quiero empezar — pedir valoración
          <svg class="transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Sección 8 · Cierre -->
  <section class="bg-primary text-primary-foreground">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 md:py-24">
      <h2 class="font-serif text-3xl sm:text-4xl">¿Prefieres que te llamemos?</h2>
      <p class="mt-4 text-lg text-primary-foreground/80">
        Déjanos tu teléfono o escríbenos ahora. Te contactamos en menos de 2 horas laborables.
      </p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="inline-flex h-14 items-center justify-center gap-2 rounded-xl bg-[#25D366] px-8 text-base font-semibold text-white transition-transform hover:scale-[1.03]">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
          Escribir por WhatsApp
        </a>
        <a href={`tel:${PHONE_TEL}`} class="inline-flex h-14 items-center justify-center gap-2 rounded-xl bg-white px-8 text-base font-semibold text-primary transition-transform hover:scale-[1.03]">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Llamar ahora
        </a>
      </div>
    </div>
  </section>

  <!-- Pie minimalista -->
  <footer class="bg-foreground text-white/80">
    <div class="mx-auto max-w-5xl px-4 py-12 text-sm sm:px-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-serif text-lg text-white">Römenn Inmobiliaria</p>
          <p class="mt-1">Pl. León Felipe 6, posterior, local 2 · 28523 Rivas-Vaciamadrid</p>
          <p class="mt-1">Lun–Vie 9:00–20:00 · Sáb 10:00–14:00</p>
        </div>
        <div class="flex flex-col gap-1 sm:text-right">
          <a href={`tel:${PHONE_TEL}`} class="text-white hover:underline">747 488 562</a>
          <a href="/privacidad" class="hover:underline">Política de privacidad</a>
          <a href="/aviso-legal" class="hover:underline">Aviso legal</a>
        </div>
      </div>
    </div>
  </footer>
</LandingLayout>

<style>
  /* Sistema de botones CTA de la landing: misma altura y peso visual,
     para que el primario y el secundario encajen perfectamente. */
  .btn-cta-primary {
    display: inline-flex;
    height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.75rem;
    background-color: hsl(var(--primary));
    padding-inline: 2rem;
    font-size: 1rem;
    font-weight: 600;
    color: hsl(var(--primary-foreground));
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }
  .btn-cta-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px -8px hsl(var(--primary) / 0.55);
  }

  .btn-cta-secondary {
    display: inline-flex;
    height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.75rem;
    border: 1px solid hsl(var(--primary) / 0.25);
    background-color: #ffffff;
    padding-inline: 2rem;
    font-size: 1rem;
    font-weight: 600;
    color: hsl(var(--primary));
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .btn-cta-secondary:hover {
    transform: translateY(-1px);
    border-color: hsl(var(--primary));
    background-color: hsl(var(--secondary) / 0.5);
  }

  /* En móvil ocupan todo el ancho; desde sm vuelven a su tamaño natural. */
  @media (max-width: 639px) {
    .btn-cta-primary,
    .btn-cta-secondary {
      width: 100%;
    }
  }
</style>
