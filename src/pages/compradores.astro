---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BuyerTest from "@/components/BuyerTest";
---

<BaseLayout title="Personal Shopper - Compradores" hasForm={true}>
  <main class="flex-grow py-20 px-6 flex flex-col items-center justify-center bg-muted/30 pt-32">
    <div class="text-center mb-12 max-w-3xl">
      <span class="text-xs font-bold uppercase tracking-widest text-accent mb-4 block">Personal Shopper</span>
      <h1 class="text-4xl md:text-5xl font-serif mb-6">Encontramos tu hogar ideal</h1>
      <p class="text-xl text-muted-foreground font-sans font-light">
        No pierdas el tiempo en portales. Cuéntanos qué necesitas y nuestro algoritmo de búsqueda Off-Market lo encontrará.
      </p>
    </div>
    
    <BuyerTest client:visible />

    <div class="mt-12 max-w-2xl text-center">
      <a href="/blog/propiedades-off-market-madrid/" class="text-primary hover:underline text-sm font-medium">
        Descubre qué es una propiedad off-market y cómo acceder a las mejores oportunidades en Madrid →
      </a>
    </div>
  </main>
</BaseLayout>
