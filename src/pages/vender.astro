---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
import ComparisonTable from "@/components/ComparisonTable";
---

<BaseLayout title="Vender con Römenn">
  <!-- Hero Section - Rediseñado sin imagen -->
  <section class="relative py-24 md:py-32 px-6 pt-44 bg-gradient-to-b from-muted/30 to-background">
    <div class="max-w-4xl mx-auto text-center space-y-8">
      <span class="text-accent uppercase tracking-widest text-xs font-bold">Servicio de Venta Premium</span>
      <h1 class="text-4xl md:text-6xl font-serif leading-tight">
        El arte de vender <br/>
        <span class="italic text-muted-foreground">tu propiedad.</span>
      </h1>
      <p class="text-lg md:text-xl font-light text-muted-foreground max-w-2xl mx-auto">
        No solo vendemos casas. Creamos una estrategia personalizada que maximiza el valor de tu patrimonio con posicionamiento premium y una red cualificada de compradores.
      </p>
      
      <!-- Stats Row -->
      <div class="grid grid-cols-3 gap-4 md:gap-8 py-8 max-w-2xl mx-auto">
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-serif text-primary mb-1">+500</div>
          <p class="text-xs text-muted-foreground uppercase tracking-wide">Compradores VIP validados</p>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-serif text-primary mb-1">98%</div>
          <p class="text-xs text-muted-foreground uppercase tracking-wide">Satisfacción de clientes</p>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-serif text-primary mb-1">90</div>
          <p class="text-xs text-muted-foreground uppercase tracking-wide">Días garantía venta</p>
        </div>
      </div>
      
      <a href="/valoracion/" class="inline-block">
        <Button className="btn-premium" client:load>Solicitar Valoración Gratuita</Button>
      </a>
    </div>
  </section>

  <!-- Servicios Premium de Venta -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="text-xs uppercase tracking-[0.25em] text-accent font-bold mb-6 block">
          Servicios Premium
        </span>
        <h2 class="text-3xl md:text-5xl font-serif mb-4">
          Todo lo que necesitas para vender
        </h2>
        <p class="text-muted-foreground font-light max-w-2xl mx-auto">
          Una estrategia integral diseñada para maximizar el valor de tu propiedad y encontrar al comprador ideal.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Red de Clientes VIP -->
        <div class="group p-8 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-lg hover:border-primary/20 transition-all duration-300">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="text-xl font-serif mb-4 text-primary">Red Exclusiva de Clientes VIP</h3>
          <ul class="space-y-3 text-muted-foreground font-light">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              +500 compradores validados económicamente
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Conexión personalizada inmueble-comprador
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Informes semanales detallados del proceso
            </li>
          </ul>
        </div>

        <!-- Posicionamiento Digital -->
        <div class="group p-8 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-lg hover:border-primary/20 transition-all duration-300">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          </div>
          <h3 class="text-xl font-serif mb-4 text-primary">Posicionamiento Digital Exclusivo</h3>
          <ul class="space-y-3 text-muted-foreground font-light">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Publicación destacada en Idealista, Fotocasa, Habitaclia
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Reportajes con mínimo 30 imágenes profesionales
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Visitas virtuales interactivas en alta definición
            </li>
          </ul>
        </div>

        <!-- Servicio Integral -->
        <div class="group p-8 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-lg hover:border-primary/20 transition-all duration-300">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/></svg>
          </div>
          <h3 class="text-xl font-serif mb-4 text-primary">Servicio Integral Profesional</h3>
          <ul class="space-y-3 text-muted-foreground font-light">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Gestión completa: Ayuntamiento, Registro, Notaría
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Departamento jurídico interno sin coste adicional
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Plan gratuito de pintura y decoración básica
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Servicio postventa con asesoría en mudanza
            </li>
          </ul>
        </div>

        <!-- Asesoramiento Financiero Kiron -->
        <div class="group p-8 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-lg hover:border-primary/20 transition-all duration-300">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
          </div>
          <h3 class="text-xl font-serif mb-4 text-primary">Asesoramiento Financiero Élite</h3>
          <ul class="space-y-3 text-muted-foreground font-light">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Hipotecas personalizadas con convenios exclusivos
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Maximización del precio final
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Patrocinios estratégicos para mayor visibilidad
            </li>
          </ul>
        </div>

        <!-- Plan Recomendador -->
        <div class="group p-8 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-lg hover:border-primary/20 transition-all duration-300">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          </div>
          <h3 class="text-xl font-serif mb-4 text-primary">Plan Recomendador</h3>
          <ul class="space-y-3 text-muted-foreground font-light">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Recompensa económica por recomendaciones exitosas
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Programa de fidelización exclusivo
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Garantía Premium -->
  <section class="py-24 bg-primary text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
      </div>
      <span class="text-accent uppercase tracking-widest text-xs font-bold mb-4 block">Garantía Premium</span>
      <h2 class="text-3xl md:text-4xl font-serif mb-6">Compromiso de Venta</h2>
      <p class="text-xl text-white/90 font-light mb-8 max-w-2xl mx-auto">
        Si no vendemos tu vivienda en <strong class="text-accent">90 días</strong>, reducimos nuestros honorarios.
      </p>
      <p class="text-white/70 font-light max-w-xl mx-auto">
        No somos una agencia más. Somos la referencia en confianza, calidad y resultados. 
        Por eso nuestros clientes no solo nos eligen... nos recomiendan.
      </p>
    </div>
  </section>

  <!-- Comparison Section -->
  <section class="py-24 bg-muted/30">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-serif mb-6">¿Por qué Römenn?</h2>
        <p class="text-muted-foreground font-light max-w-2xl mx-auto">
          Nuestro método permite una revalorización del activo de hasta un 22% por encima de la media del sector, sumando posicionamiento estratégico y eficiencia financiera.
        </p>
      </div>
      <ComparisonTable client:visible />
    </div>
  </section>

  <!-- Blog link -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6">
      <a href="/blog/vender-piso-rivas-vaciamadrid/" class="group flex items-center gap-6 bg-white p-6 rounded-xl border border-slate-200 hover:shadow-md transition-shadow">
        <div class="shrink-0 w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>
        </div>
        <div>
          <p class="text-xs text-accent font-bold uppercase tracking-widest mb-1">Guía en el blog</p>
          <p class="font-serif text-primary group-hover:text-accent transition-colors">Cómo Vender tu Piso en Rivas-Vaciamadrid en 2026: Guía Paso a Paso</p>
        </div>
      </a>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-serif mb-8">Comencemos con una conversación.</h2>
      <p class="text-muted-foreground mb-12 max-w-xl mx-auto font-light">
        Descubre el verdadero valor de tu propiedad con una valoración gratuita y sin compromiso.
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a href="/valoracion/" class="inline-flex items-center justify-center bg-primary text-white px-10 py-4 text-sm tracking-widest uppercase font-bold rounded-xl shadow-lg hover:bg-primary/90 transition-colors">
          Solicitar Valoración Gratuita
        </a>
        <a href="/contacto/" class="inline-flex items-center justify-center border-2 border-primary text-primary px-10 py-4 text-sm tracking-widest uppercase font-bold bg-transparent rounded-xl hover:bg-primary/5 transition-colors">
          Contactar
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
