---
import "@/styles/globals.css";
import { Font } from "astro:assets";
import { Toaster } from "@/components/ui/sonner";
import { SEO } from "astro-seo";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Vende tu casa en Rivas-Vaciamadrid con Römenn. Valoración gratuita y sin compromiso en menos de 24 h.",
  image,
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImagePath = image || "/og/index.png";
const imageURL = new URL(ogImagePath, Astro.site);

// Teléfono SIEMPRE sin espacios para que dispare el activador de GTM.
const PHONE_TEL = "+34747488562";
const PHONE_DISPLAY = "747 488 562";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="dns-prefetch" href="https://api.romenninmobiliaria.es" />
    <link rel="preconnect" href="https://api.romenninmobiliaria.es" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-playfair" preload />

    <SEO
      title={title}
      titleTemplate="%s | Römenn"
      titleDefault="Römenn - Inmobiliaria Boutique"
      description={description}
      canonical={canonicalURL.href}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: `${title} | Römenn Inmobiliaria`,
          type: "website",
          image: imageURL.href,
          url: canonicalURL.href,
        },
        optional: {
          description: description,
          locale: "es_ES",
          siteName: "Römenn Inmobiliaria",
        },
      }}
      extend={{
        link: [
          { rel: "icon", href: "/romenn-logo.svg", type: "image/svg+xml" },
          { rel: "apple-touch-icon", href: "/romenn-logo.svg" },
        ],
        meta: [
          { name: "theme-color", content: "#816649" },
          { name: "robots", content: noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large" },
          { name: "geo.region", content: "ES-M" },
          { name: "geo.placename", content: "Rivas-Vaciamadrid" },
        ],
      }}
    />

    <!-- Google Tag Manager - deferred (igual que el resto de la web) -->
    <script is:inline>
      (function (w, d, id, delay, l) {
        let a = false;
        function g() {
          if (a) return;
          a = true;
          const s = d.createElement("script");
          s.async = 1;
          s.src = "https://www.googletagmanager.com/gtm.js?id=" + id;
          s.onload = () => {
            w[l] = w[l] || [];
            w[l].push({ event: "gtm.js", "gtm.start": Date.now(), "gtm.uniqueEventId": 0 });
          };
          d.head.appendChild(s);
        }
        function o(e) {
          g();
          e.currentTarget.removeEventListener(e.type, o);
        }
        d.addEventListener("DOMContentLoaded", () => setTimeout(g, delay));
        ["scroll", "pointerdown", "keydown", "touchstart", "mousemove"].forEach((ev) => {
          d.addEventListener(ev, o, { passive: !0 });
        });
      })(window, document, "GTM-TJPFPVFH", 3500, "dataLayer");
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground overflow-x-hidden">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TJPFPVFH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <!-- Cabecera minimalista: solo logo + teléfono (sin menú = menos fugas) -->
    <header class="sticky top-0 z-50 w-full border-b border-border bg-white/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center" aria-label="Römenn Inmobiliaria">
          <img
            src="/romenn-logo.svg"
            alt="Römenn Inmobiliaria"
            width="120"
            height="48"
            class="h-12 w-auto object-contain brightness-0"
          />
        </a>
        <a
          href={`tel:${PHONE_TEL}`}
          class="inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span class="hidden sm:inline">{PHONE_DISPLAY}</span>
          <span class="sm:hidden">Llamar</span>
        </a>
      </div>
    </header>

    <main id="main-content" role="main">
      <slot />
    </main>

    <!-- Botón fijo de Llamar en móvil (requisito del informe) -->
    <a
      href={`tel:${PHONE_TEL}`}
      class="fixed bottom-4 left-4 right-20 z-40 flex items-center justify-center gap-2 rounded-full bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground shadow-2xl sm:hidden"
      aria-label="Llamar a Römenn Inmobiliaria"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      Llamar ahora
    </a>

    <!-- WhatsApp flotante (target _blank para dar tiempo a disparar la conversión) -->
    <a
      href="https://wa.me/34747488562"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-4 right-4 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-2xl transition-transform hover:scale-110"
      aria-label="Contactar por WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="white" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
    </a>

    <Toaster client:load />
  </body>
</html>
