# Security + Cache headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Global security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googletagmanager.com https://*.google-analytics.com https://tagmanager.google.com https://*.googletagservices.com https://www.googleadservices.com https://*.doubleclick.net https://*.cookieyes.com https://cdn-cookieyes.com; script-src-elem 'self' 'unsafe-inline' https://*.googletagmanager.com https://*.google-analytics.com https://tagmanager.google.com https://*.googletagservices.com https://www.googleadservices.com https://*.doubleclick.net https://*.cookieyes.com https://cdn-cookieyes.com; style-src 'self' 'unsafe-inline' https://tagmanager.google.com https://fonts.googleapis.com https://cdn-cookieyes.com; style-src-elem 'self' 'unsafe-inline' https://tagmanager.google.com https://fonts.googleapis.com https://cdn-cookieyes.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://cdn-cookieyes.com; connect-src 'self' https://*.romenninmobiliaria.es https://www.google.com https://www.googleadservices.com https://*.doubleclick.net https://analytics.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.cookieyes.com; frame-src 'self' https://*.googletagmanager.com https://*.doubleclick.net https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Video files - cache for 1 year
/video_hero.mp4
  Cache-Control: public, max-age=31536000, immutable

# Images - cache for 1 year
/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/hero-frame.webp
  Cache-Control: public, max-age=31536000, immutable

/romenn-logo.svg
  Cache-Control: public, max-age=31536000, immutable

/romenn-logo.png
  Cache-Control: public, max-age=31536000, immutable

# Fonts - cache for 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# JS and CSS with hashes - cache for 1 year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages - short cache, revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate